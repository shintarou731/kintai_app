<%# 打刻修正申請の操作（取り下げ・出し直し）。申請の詳細（本人）で使う %>
<% date_label = approval_request.target_label %>
<% can_resubmit = approval_request.is_a?(AttendanceCorrectionRequest) && approval_request.target_date <= Date.current &&
                  !current_user.attendance_correction_requests.pending.exists?(target_date: approval_request.target_date) %>
<section class="card section request-actions" aria-labelledby="actions-title" data-testid="request-actions">
  <h2 id="actions-title" class="visually-hidden">操作</h2>
  <% case approval_request.status %>
  <% when "pending" %>
    <p class="request-actions__note">管理者の承認を待っています。承認されるまで勤怠記録は変わりません（勤怠履歴のこの日には「申請中」と表示されます）。</p>
    <div class="form__actions">
      <%= button_to "この申請を取り下げる", approval_request_withdrawal_path(approval_request),
                    class: "button button--danger", form_class: "request-actions__form",
                    data: { turbo_confirm: "#{date_label} の#{approval_request.kind_label}申請を取り下げますか？",
                            turbo_submits_with: "取り下げ中…", testid: "withdraw-button" } %>
      <%= link_to "勤怠履歴で見る", attendances_path(month: WorkRules.current.period_containing(approval_request.target_date).to_param),
                  class: "button button--ghost" %>
    </div>
  <% when "withdrawn" %>
    <p class="request-actions__note muted">この申請は取り下げました。勤怠記録は変わっていません。</p>
    <% if can_resubmit %>
      <%= link_to "この日の修正申請を出し直す", new_attendance_correction_request_path(date: approval_request.target_date.iso8601),
                  class: "button button--ghost" %>
    <% end %>
  <% when "approved" %>
    <p class="request-actions__note" data-testid="processed-note">この申請は承認され、勤怠記録に反映されました。処理済みの申請は取り下げできません。</p>
    <%= link_to "勤怠履歴で見る", attendances_path(month: WorkRules.current.period_containing(approval_request.target_date).to_param),
                class: "button button--ghost" %>
  <% else %>
    <p class="request-actions__note" data-testid="processed-note">この申請は却下されたため、勤怠記録は変わっていません。処理済みの申請は取り下げできません。</p>
    <% if can_resubmit %>
      <p class="request-actions__note muted">内容を直して申請し直す場合は、コメントを確認してから出し直してください。</p>
      <%= link_to "この日の修正申請を出し直す", new_attendance_correction_request_path(date: approval_request.target_date.iso8601),
                  class: "button button--ghost" %>
    <% end %>
  <% end %>
</section>
