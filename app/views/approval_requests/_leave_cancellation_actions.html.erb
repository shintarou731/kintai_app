<%# 休暇の取消申請の操作（本人）：承認待ちなら取り下げ（休暇は有効のまま） %>
<% leave = cancellation.leave_request %>
<section class="card section request-actions" aria-labelledby="actions-title" data-testid="request-actions">
  <h2 id="actions-title" class="visually-hidden">操作</h2>
  <% case cancellation.status %>
  <% when "pending" %>
    <p class="request-actions__note">管理者の承認を待っています。承認されるまで休暇は有効です（承認されると休暇が取り消されます）。</p>
    <div class="form__actions">
      <%= button_to "この取消申請を取り下げる", approval_request_withdrawal_path(cancellation),
                    class: "button button--danger", form_class: "request-actions__form",
                    data: { turbo_confirm: "#{leave.description}の取消申請を取り下げますか？休暇は有効のままです。",
                            turbo_submits_with: "取り下げ中…", testid: "withdraw-button" } %>
      <%= link_to "休暇の申請を見る", approval_request_path(leave), class: "button button--ghost" %>
    </div>
  <% when "withdrawn" %>
    <p class="request-actions__note muted">この取消申請は取り下げました。休暇は有効のままです。</p>
    <%= link_to "休暇の申請を見る", approval_request_path(leave), class: "button button--ghost" %>
  <% when "approved" %>
    <% if cancellation.closed_by_direct_cancellation? %>
      <p class="request-actions__note" data-testid="processed-note">管理者が休暇を直接取り消したため、この取消申請は処理済みになりました。休暇は取り消されており、勤怠履歴には表示されません。</p>
    <% else %>
      <p class="request-actions__note" data-testid="processed-note">取消申請が承認され、休暇は取り消されました。勤怠履歴には表示されません。</p>
    <% end %>
    <%= link_to "休暇の申請を見る", approval_request_path(leave), class: "button button--ghost" %>
  <% else %>
    <p class="request-actions__note" data-testid="processed-note">取消申請は却下されたため、休暇は有効のままです。処理済みの申請は取り下げできません。</p>
    <%= link_to "休暇の申請を見る", approval_request_path(leave), class: "button button--ghost" %>
  <% end %>
</section>
