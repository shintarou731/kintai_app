<% correction = @correction %>
<% date = correction.target_date %>
<% date_label = l(date, format: :short_with_day) %>
<% current = correction.current_attendance %>
<% history_path = attendances_path(month: WorkRules.current.period_containing(date).to_param) %>
<% content_for :title, "打刻修正申請（#{date_label}）" %>

<div class="page page--narrow">
  <%= link_to "← 勤怠履歴に戻る", history_path, class: "back-link" %>
  <header class="page__header">
    <p class="page__eyebrow">申請</p>
    <h1 class="page__title">打刻修正申請 <span class="correction-date" data-testid="correction-target-date"><%= l(date, format: :long) %></span></h1>
    <p class="page__lead muted">この日の正しい出勤・退勤・休憩の時刻と理由を入力して申請します。管理者が承認するまで、勤怠記録は変わりません。</p>
  </header>

  <section class="card section correction-current" aria-labelledby="current-title" data-testid="current-record">
    <h2 id="current-title" class="card__title card__title--small">今の記録</h2>
    <% if current %>
      <dl class="correction-current__list">
        <div><dt>出勤</dt><dd><%= correction_time_label(current.clock_in_at, date) %></dd></div>
        <div>
          <dt>退勤</dt>
          <dd>
            <%= correction_time_label(current.clock_out_at, date) %>
            <% if current.missing_clock_out? %><span class="badge badge--danger">退勤漏れ</span><% end %>
          </dd>
        </div>
        <div><dt>休憩</dt><dd><%= correction_breaks_label(current.breaks.to_a, date) %></dd></div>
      </dl>
      <p class="form__hint">下の入力欄には今の記録を入れてあります。正しくない所だけ直してください。</p>
    <% else %>
      <p class="muted correction-current__empty">この日の打刻はありません。出勤・退勤・休憩の時刻を入力してください。</p>
    <% end %>
  </section>

  <section class="card section" aria-labelledby="form-title">
    <h2 id="form-title" class="card__title">申請する内容</h2>

    <%= form_with model: correction, url: attendance_correction_requests_path, class: "form correction-form",
                  data: { testid: "correction-form" } do |f| %>
      <%= render "shared/form_errors", record: correction %>
      <%= f.hidden_field :target_date, value: date.iso8601 %>

      <div class="correction-form__times">
        <div class="form__field">
          <%= f.label :clock_in_time, class: "form__label" do %>出勤 <span class="form__required">必須</span><% end %>
          <div class="time-input">
            <span class="time-input__day" aria-hidden="true"><%= date_label %></span>
            <%= f.time_field :clock_in_time, class: "form__input time-input__time", required: true,
                                             aria: { describedby: "clock-in-hint" } %>
          </div>
          <p class="form__hint" id="clock-in-hint">出勤は対象日（<%= date_label %>）の時刻です。</p>
        </div>

        <div class="form__field">
          <%= f.label :clock_out_time, class: "form__label" do %>
            退勤 <% if correction.clock_out_optional? %><span class="form__optional">勤務中なら空欄</span><% else %><span class="form__required">必須</span><% end %>
          <% end %>
          <div class="time-input">
            <%= f.select :clock_out_day, correction_day_options(date), {},
                         class: "form__input time-input__select", "aria-label": "退勤の日付" %>
            <%= f.time_field :clock_out_time, class: "form__input time-input__time", aria: { describedby: "clock-out-hint" } %>
          </div>
          <p class="form__hint" id="clock-out-hint">
            日付をまたいで退勤した場合（例：22:00 出勤 → 翌 2:00 退勤）は、日付で「翌日」を選んでください。
            <% if correction.clock_out_optional? %>まだ勤務中の場合は空欄のままにできます。<% end %>
          </p>
        </div>
      </div>

      <% rows = correction.break_inputs.presence || [ AttendanceCorrectionRequest::BreakInput.new(start_day: "0", end_day: "0") ] %>
      <fieldset class="correction-breaks" data-controller="break-rows"
                data-break-rows-max-value="<%= AttendanceCorrectionRequest::MAX_BREAKS %>" data-testid="correction-breaks">
        <legend class="form__label">休憩 <span class="form__optional">任意・<%= AttendanceCorrectionRequest::MAX_BREAKS %>回まで</span></legend>
        <p class="form__hint correction-breaks__hint">開始と終了の両方を入力します。休憩しなかった場合は空欄のままにしてください。日付をまたぐ休憩は「翌日」を選びます。</p>

        <ol class="correction-breaks__list" data-break-rows-target="list">
          <% rows.each_with_index do |input, index| %>
            <%= render "break_row", input: input, index: index, number: index + 1, date: date,
                                    invalid: correction.invalid_break_numbers.include?(index + 1) %>
          <% end %>
        </ol>

        <template data-break-rows-target="template">
          <%= render "break_row", input: AttendanceCorrectionRequest::BreakInput.new(start_day: "0", end_day: "0"),
                                  index: "NEW_INDEX", number: "", date: date, invalid: false %>
        </template>

        <button type="button" class="button button--ghost button--small" data-action="break-rows#add"
                data-break-rows-target="addButton" data-testid="add-break">＋ 休憩を追加</button>
      </fieldset>

      <div class="form__field">
        <%= f.label :reason, class: "form__label" do %>理由 <span class="form__required">必須</span><% end %>
        <%= f.text_area :reason, class: "form__input form__textarea", rows: 3, required: true,
                                 maxlength: ApprovalRequest::REASON_MAX_LENGTH, aria: { describedby: "reason-hint" },
                                 placeholder: "例：退勤の打刻を忘れました。18:00 に退勤しています。" %>
        <p class="form__hint" id="reason-hint">何を、なぜ直すのかを書いてください（<%= ApprovalRequest::REASON_MAX_LENGTH %>文字まで）。</p>
      </div>

      <div class="form__actions">
        <%= f.submit "申請する", class: "button button--primary", data: { turbo_submits_with: "申請中…" } %>
        <%= link_to "キャンセル", history_path, class: "button button--ghost" %>
      </div>
    <% end %>
  </section>
</div>
