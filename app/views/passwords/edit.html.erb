<% content_for :title, "パスワード変更" %>

<div class="page page--narrow">
  <%= link_to "← アカウント情報に戻る", account_path, class: "back-link", data: { testid: "password-back-link" } %>
  <header class="page__header">
    <h1 class="page__title">パスワード変更</h1>
  </header>

  <section class="card">
    <p class="card__lead">本人確認のため、現在のパスワードを入力してください。</p>

    <%= form_with model: @user, url: password_path, method: :patch, class: "form" do |f| %>
      <%= render "shared/form_errors", record: @user %>

      <div class="form__field">
        <%= f.label :current_password, class: "form__label" %>
        <%= f.password_field :current_password, class: "form__input", required: true, autocomplete: "current-password" %>
      </div>

      <div class="form__field">
        <%= f.label :password, "新しいパスワード", class: "form__label" %>
        <%= f.password_field :password, class: "form__input", required: true, minlength: User::PASSWORD_MIN_LENGTH,
                                        autocomplete: "new-password", aria: { describedby: "password-hint" } %>
        <p class="form__hint" id="password-hint"><%= User::PASSWORD_MIN_LENGTH %>文字以上で入力してください。</p>
      </div>

      <div class="form__field">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form__label" %>
        <%= f.password_field :password_confirmation, class: "form__input", required: true, autocomplete: "new-password" %>
      </div>

      <div class="form__actions">
        <%= f.submit "変更する", class: "button button--primary" %>
        <%= link_to "キャンセル", account_path, class: "button button--ghost" %>
      </div>
    <% end %>
  </section>
</div>
