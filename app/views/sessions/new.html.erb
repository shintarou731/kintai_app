<% content_for :title, "ログイン" %>

<div class="auth">
  <div class="auth__brand">
    <span class="header__logo header__logo--large" aria-hidden="true">K</span>
    <span class="auth__app-name">キンタイ帳</span>
  </div>

  <section class="card auth__card">
    <h1 class="card__title">ログイン</h1>

    <%= form_with url: login_path, method: :post, class: "form" do |f| %>
      <div class="form__field">
        <%= f.label :email, "メールアドレス", class: "form__label" %>
        <%= f.email_field :email, value: @email, class: "form__input", required: true, autofocus: true, autocomplete: "username" %>
      </div>

      <div class="form__field">
        <%= f.label :password, "パスワード", class: "form__label" %>
        <%= f.password_field :password, class: "form__input", required: true, autocomplete: "current-password" %>
      </div>

      <%= f.submit "ログイン", class: "button button--primary button--block" %>
    <% end %>

    <p class="auth__note">アカウントは管理者が発行します。パスワードがわからない場合は管理者にお問い合わせください。</p>
  </section>
</div>
